{
  "plugins": ["typescript", "import", "unicorn", "node"],
  "rules": {
    "no-console": "error",
    "eqeqeq": "error",
    "no-sparse-arrays": "off",
    "no-underscore-dangle": "off",
    "no-unused-expressions": "off"
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "ignorePatterns": ["**/*.xml", "**/*.json", "**/*.rels", "old-repo/**", "dist/**", "node_modules/**"]
}
