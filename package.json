{
  "name": "@office-core/exceljs",
  "version": "5.0.1",
  "description": "A modern, high-performance evolution of ExcelJS, carrying forward its battle-tested standard into contemporary Node.js and TypeScript environments.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rawlings/exceljs.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint --report-unused-disable-directives-severity=error src tests",
    "lint:check": "oxlint --report-unused-disable-directives-severity=error src tests",
    "lint:fix": "oxlint --report-unused-disable-directives-severity=error --fix src tests",
    "format": "oxfmt --write src tests vitest.config.ts",
    "format:check": "oxfmt --check src tests vitest.config.ts",
    "format:fix": "oxfmt --write src tests vitest.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.spec.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}