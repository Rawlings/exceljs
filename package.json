{
  "name": "exceljs",
  "version": "4.4.0",
  "description": "Excel Workbook Manager - Read and Write xlsx and csv Files.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/exceljs/exceljs.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#src": "./src/index.js",
    "#src/*": "./src/*",
    "#fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint --fix src tests",
    "format": "oxfmt src",
    "format:fix": "oxfmt --write src",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.spec.json"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
